# Neon pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=

# Neon direct connection string (no "-pooler"). Used only by npm run db:migrate.
DATABASE_URL_UNPOOLED=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Encrypts every assignment. Use a different value on each Neon branch.
# If it is lost or changed after a draw, existing envelopes can't be opened.
APP_SECRET=

# Wishlist photos: Neon Object Storage for THIS branch (see docs/NEON_SETUP.md, step 6).
# Server-only. Never prefix these with NEXT_PUBLIC_. Get them with: neon env pull --file .env.local
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Lets Vercel's daily cron delete abandoned photo uploads. Any long random value.
CRON_SECRET=

# Optional. A Messenger or Viber link shown as "Message the organizer" on the Help tab.
NEXT_PUBLIC_ORGANIZER_CONTACT_URL=
