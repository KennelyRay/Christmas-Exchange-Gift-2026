    "drizzle-orm": "^0.45.4",
    "heic-to": "^1.6.7",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
